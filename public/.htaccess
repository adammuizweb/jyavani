Options -Indexes

RewriteEngine On
RewriteBase /

# Hilangkan trailing slash pada file statis
RewriteRule ^(.+\.(?:css|js|mjs|map|webp|avif|png|jpg|jpeg|gif|svg|ico|json|webmanifest|woff2?|woff|ttf|eot|xml|txt))/$ $1 [R=302,L,NE]

# Blokir dot-files
RewriteRule (^|/)\. - [F,L]

# Root PWA endpoints are dynamic and must replace any stale physical files.
RewriteRule ^(?:sw\.js|manifest\.webmanifest)$ router.php [L,QSA]

# Serve real files directly.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Execute only directories that intentionally expose an index.php. Physical
# directories without an entrypoint continue to Core's themed 404 renderer.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^ - [L]

# Router fallback
RewriteRule ^ router.php [L,QSA]

# MIME yang sering bikin alert
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType application/xml .xml
AddType text/plain .txt

# Blokir file sensitif
<FilesMatch "\.(env|ini|log|sh|sql|bak|dist|yml|yaml|md)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset ETag
</IfModule>
