{
    "folder": "adam",
    "name": "Adamz Code",
    "description": "Tema premium untuk blog teknologi, programming, dan filosofi. Dark mode, SEO lengkap, i18n siap pakai.",
    "version": "2.3.1",
    "php_required": "8.1",
    "author": "adammuiz",
    "screenshot": "img.png",
    "color_mode": "both",
    "customizer": {
        "sections": {
            "header": {
                "label": "Header",
                "fields": {
                    "logo": {
                        "type": "image",
                        "label": "Logo image"
                    },
                    "nav_menu": {
                        "type": "menu",
                        "label": "Navigation menu"
                    },
                    "show_theme": {
                        "type": "toggle",
                        "label": "Show theme selector"
                    },
                    "show_lang": {
                        "type": "toggle",
                        "label": "Show language selector"
                    },
                    "show_search": {
                        "type": "toggle",
                        "label": "Show search box"
                    }
                }
            },
            "main": {
                "label": "Main Content",
                "fields": {
                    "show_sidebar": {
                        "type": "toggle",
                        "label": "Show sidebar"
                    },
                    "show_post_meta": {
                        "type": "toggle",
                        "label": "Show post meta"
                    },
                    "show_author": {
                        "type": "toggle",
                        "label": "Show author"
                    },
                    "show_date": {
                        "type": "toggle",
                        "label": "Show date"
                    },
                    "show_read_time": {
                        "type": "toggle",
                        "label": "Show read time"
                    }
                }
            },
            "footer": {
                "label": "Footer",
                "fields": {
                    "footer_text": {
                        "type": "textarea",
                        "label": "Footer / copyright text"
                    },
                    "footer_menu": {
                        "type": "menu",
                        "label": "Footer menu"
                    },
                    "footer_sidebar_zone": {
                        "type": "sidebar_zone",
                        "label": "Footer sidebar zone"
                    },
                    "show_social": {
                        "type": "toggle",
                        "label": "Show social icons"
                    }
                }
            }
        }
    },
    "layout": {
        "header": {
            "label": "Header",
            "positions": {
                "logo": {
                    "label": "Logo",
                    "grid": "1 / 2"
                },
                "nav": {
                    "label": "Navigasi",
                    "grid": "2 / 3"
                },
                "controls": {
                    "label": "Controller",
                    "grid": "3 / 4"
                }
            },
            "defaults": {
                "logo": {
                    "type": "tz_html",
                    "title": "Logo Adamz",
                    "config": {
                        "title": "",
                        "html": "<a href=\"/\" class=\"brand onload wave-span\" data-anim-trigger=\"load\" data-wave-target=\".adamz-logo\" data-wave-step=\"28\">\n  <span class=\"adamz-logo-mark\" aria-hidden=\"true\">ADZ</span>\n  <span class=\"adamz-logo\" aria-label=\"Adamz Code\">\n    <span class=\"letter accent\" data-word=\"Code\">A</span>\n    <span class=\"letter base\" data-word=\"Think\">d</span>\n    <span class=\"letter accent\" data-word=\"Explore\">a</span>\n    <span class=\"letter base\" data-word=\"Build\">m</span>\n    <span class=\"letter base\" data-word=\"Share\">z</span>\n  </span>\n</a>"
                    }
                },
                "nav": {
                    "type": "tz_nav_menu",
                    "title": "Main Menu",
                    "config": {
                        "menu": "primary",
                        "menu_class": "menu expand-center-safe moving-line onload",
                        "depth": 0,
                        "ul_attr": "data-anime-trigger=\"load\" data-duration=\"2500\" data-delay=\"360\" data-ml-duration=\"1000\" data-ml-delay=\"520\""
                    }
                },
                "controls": [
                    {
                        "type": "tz_html",
                        "title": "Controller",
                        "config": {
                            "html": "<select id=\"themeSelect\" class=\"ctrl-item blur-in onload\" data-anime-trigger=\"load\" data-duration=\"1700\" data-delay=\"760\">\n  <option value=\"light\">Light</option>\n  <option value=\"dark\">Dark</option>\n</select>\n<select id=\"lang-switch\" class=\"ctrl-item blur-in onload\" data-anime-trigger=\"load\" data-duration=\"700\" data-delay=\"860\">\n  <option value=\"id\">ID</option>\n  <option value=\"en\">EN</option>\n</select>\n<form method=\"get\" action=\"/\">\n  <input type=\"search\" name=\"s\" class=\"ctrl-item pop\" data-anime-trigger=\"load\" data-duration=\"1000\" data-delay=\"1000\" placeholder=\"Search...\" style=\"width:120px;max-width:140px;\">\n</form>"
                        }
                    }
                ]
            },
            "columns": 3
        },
        "main": {
            "label": "Main Content",
            "positions": {
                "meta": {
                    "label": "Post Meta"
                },
                "content": {
                    "label": "Content Area"
                },
                "sidebar": {
                    "label": "Sidebar"
                }
            }
        },
        "footer": {
            "label": "Footer",
            "positions": {
                "about": {
                    "label": "About/Logo",
                    "row": 1,
                    "align": "left"
                },
                "pages": {
                    "label": "Pages",
                    "row": 1,
                    "align": "center"
                },
                "social": {
                    "label": "Social",
                    "row": 1,
                    "align": "center"
                },
                "copyright": {
                    "label": "Copyright",
                    "row": 2,
                    "align": "center"
                }
            },
            "defaults": {
                "about": [
                    {
                        "type": "tz_html",
                        "title": "Brand",
                        "config": {
                            "title": "",
                            "html": "<a href=\"/\" class=\"brand onload wave-span\" data-anim-trigger=\"load\" data-wave-target=\".adamz-logo\" data-wave-step=\"28\">\n  <span class=\"adamz-logo-mark\" aria-hidden=\"true\">ADZ</span>\n  <span class=\"adamz-logo\" aria-label=\"Adamz Code\">\n    <span class=\"letter accent\" data-word=\"Code\">A</span>\n    <span class=\"letter base\" data-word=\"Think\">d</span>\n    <span class=\"letter accent\" data-word=\"Explore\">a</span>\n    <span class=\"letter base\" data-word=\"Build\">m</span>\n    <span class=\"letter base\" data-word=\"Share\">z</span>\n  </span>\n</a>"
                        }
                    },
                    {
                        "type": "tz_html",
                        "title": "About",
                        "config": {
                            "title": "About",
                            "html": "<p style=\"margin:.35rem 0 0;font-size:.85rem;opacity:.75\">Adamz Code — native PHP CMS. Fast, lightweight, easy to customize.</p>", "_title_tag": "div", "_align_title": "left", "_align_content": "left"
                        }
                    }
                ],
                "pages": [
                    {
                        "type": "tz_pages",
                        "title": "Pages",
                        "config": {
                            "pages": [],
                            "list_class": "tz-pages",
                            "title": "Pages"
                        }
                    }
                ],
                "social": [
                    {
                        "type": "tz_social",
                        "title": "Social",
                        "config": {
                            "enabled": [
                                "x",
                                "github",
                                "instagram"
                            ],
                            "links": [],
                            "title": "Social Media"
                        }
                    }
                ],
                "copyright": [
                    {
                        "type": "tz_html",
                        "title": "Copyright",
                        "config": {
                            "html": "<p style=\"margin:0;font-size:.85rem;opacity:.75\">&copy; 2026 Adamz Code. Released under MIT License.</p>"
                        }
                    }
                ]
            }
        },
        "single.post": {
            "label": "Single Post",
            "positions": {
                "before_content": {
                    "label": "Sebelum Konten"
                },
                "after_content": {
                    "label": "Sesudah Konten"
                }
            },
            "columns": 1
        },
        "list.post": {
            "label": "Post List",
            "positions": {
                "before_loop": {
                    "label": "Sebelum Daftar"
                },
                "after_loop": {
                    "label": "Sesudah Daftar"
                }
            },
            "columns": 1
        }
    },
    "styles": [
        "assets/css/style.css",
        "assets/css/blocks.css"
    ],
    "scripts": [
        "assets/js/script.js"
    ],
    "store": {
        "url": "https://jyavani.com/theme-store/",
        "slug": "adam"
    }
}
